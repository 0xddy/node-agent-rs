+//! Debug diagnostics for routine connection events. Unexpected errors stay at WARN.
+
+use std::fmt;
+use std::io;
+use std::time::{Duration, Instant};
+
+use parking_lot::Mutex;
+
+use crate::dns::no_addresses::is_no_addresses_error;
+
+const SAMPLE_INTERVAL: Duration = Duration::from_secs(60);
+
+// Fixed categories keep both memory and log volume bounded even when every
+// request uses a different destination or every connection a different peer.
+static DNS_NO_ADDRESSES: Mutex<SampleWindow> = Mutex::new(SampleWindow::new());
+static HYSTERIA2_TIMEOUT: Mutex<SampleWindow> = Mutex::new(SampleWindow::new());
+
+#[derive(Clone, Copy)]
+pub(crate) enum RoutineEvent {
+    DnsNoAddresses,
+    Hysteria2Timeout,
+}
+
+impl RoutineEvent {
+    pub(crate) fn log(self, message: fmt::Arguments<'_>) {
+        if !log::log_enabled!(log::Level::Debug) {
+            return;
+        }
+        let (category, window) = match self {
+            Self::DnsNoAddresses => ("dns_no_addresses", &DNS_NO_ADDRESSES),
+            Self::Hysteria2Timeout => ("hysteria2_timeout", &HYSTERIA2_TIMEOUT),
+        };
+        let suppressed = {
+            let mut window = window.lock();
+            window.record(Instant::now())
+        };
+        if let Some(suppressed) = suppressed {
+            // Do not log while holding the limiter lock: output belongs to the
+            // application's logger. Normal operation never enters this path.
+            log::debug!(
+                "connection event: category={category}, suppressed_since_last_log={suppressed}, sample: {message}"
+            );
+        }
+    }
+}
+
+pub(crate) fn log_outbound_failure(context: fmt::Arguments<'_>, error: &io::Error) {
+    if is_no_addresses_error(error) {
+        RoutineEvent::DnsNoAddresses.log(format_args!("{context}: {error}"));
+    } else {
+        log::log!(outbound_failure_level(error), "{context}: {error}");
+    }
+}
+
+fn outbound_failure_level(error: &io::Error) -> log::Level {
+    use io::ErrorKind;
+    if matches!(
+        error.kind(),
+        ErrorKind::NotFound
+            | ErrorKind::TimedOut
+            | ErrorKind::ConnectionRefused
+            | ErrorKind::ConnectionReset
+            | ErrorKind::ConnectionAborted
+            | ErrorKind::NotConnected
+            | ErrorKind::BrokenPipe
+            | ErrorKind::HostUnreachable
+            | ErrorKind::NetworkUnreachable
+            | ErrorKind::WouldBlock
+    ) {
+        log::Level::Debug
+    } else {
+        log::Level::Warn
+    }
+}
+
+struct SampleWindow {
+    last_logged: Option<Instant>,
+    suppressed: u64,
+}
+
+impl SampleWindow {
+    const fn new() -> Self {
+        Self {
+            last_logged: None,
+            suppressed: 0,
+        }
+    }
+
+    // The first event is immediate. Later events within the interval are counted;
+    // the next event after the interval reports that count with its fresh sample.
+    // No timer or background task is started when traffic stops.
+    fn record(&mut self, now: Instant) -> Option<u64> {
+        if self
+            .last_logged
+            .is_some_and(|last| now.duration_since(last) < SAMPLE_INTERVAL)
+        {
+            self.suppressed = self.suppressed.saturating_add(1);
+            return None;
+        }
+        self.last_logged = Some(now);
+        Some(std::mem::take(&mut self.suppressed))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn routine_diagnostics_follow_runtime_level() {
+        const CHILD: &str = "SHOES_LOG_LEVEL_TEST_CHILD";
+        if std::env::var_os(CHILD).is_none() {
+            let output = std::process::Command::new(std::env::current_exe().unwrap())
+                .args([
+                    "--exact",
+                    "logging::connection_events::tests::routine_diagnostics_follow_runtime_level",
+                    "--nocapture",
+                ])
+                .env(CHILD, "1")
+                .output()
+                .unwrap();
+            assert!(output.status.success(), "child output: {output:?}");
+            return;
+        }
+
+        // This must also hold without debug_assertions: an INFO static ceiling
+        // would silently make the agent's production debug switch ineffective.
+        assert!(log::STATIC_MAX_LEVEL >= log::LevelFilter::Debug);
+        #[derive(Clone, Default)]
+        struct Capture(std::sync::Arc<Mutex<Vec<log::Level>>>);
+        impl log::Log for Capture {
+            fn enabled(&self, _: &log::Metadata<'_>) -> bool {
+                true
+            }
+            fn log(&self, record: &log::Record<'_>) {
+                self.0.lock().push(record.level());
+            }
+            fn flush(&self) {}
+        }
+        let capture = Capture::default();
+        log::set_boxed_logger(Box::new(capture.clone())).unwrap();
+        let emit = || {
+            let dns = io::Error::other(crate::dns::no_addresses::no_addresses_error(
+                "DNS lookup returned no addresses".to_owned(),
+            ));
+            log_outbound_failure(format_args!("DNS"), &dns);
+            RoutineEvent::Hysteria2Timeout.log(format_args!("connection timed out"));
+            for kind in [
+                io::ErrorKind::NotFound,
+                io::ErrorKind::TimedOut,
+                io::ErrorKind::ConnectionRefused,
+                io::ErrorKind::InvalidData,
+            ] {
+                log_outbound_failure(format_args!("outbound"), &io::Error::from(kind));
+            }
+        };
+        log::set_max_level(log::LevelFilter::Info);
+        emit();
+        assert_eq!(*capture.0.lock(), [log::Level::Warn]);
+        capture.0.lock().clear();
+        log::set_max_level(log::LevelFilter::Debug);
+        emit();
+        assert_eq!(
+            *capture.0.lock(),
+            [
+                log::Level::Debug,
+                log::Level::Debug,
+                log::Level::Debug,
+                log::Level::Debug,
+                log::Level::Debug,
+                log::Level::Warn,
+            ]
+        );
+    }
+
+    #[test]
+    fn burst_is_sampled_and_next_event_reports_suppressed_count() {
+        let mut window = SampleWindow::new();
+        let start = Instant::now();
+        assert_eq!(window.record(start), Some(0));
+        for millis in [0, 100, 200, 5_000, 59_999] {
+            assert_eq!(window.record(start + Duration::from_millis(millis)), None);
+        }
+        assert_eq!(window.record(start + SAMPLE_INTERVAL), Some(5));
+        assert_eq!(window.record(start + SAMPLE_INTERVAL), None);
+        // A quiet period does not lose the pending count or require a timer.
+        assert_eq!(window.record(start + Duration::from_secs(600)), Some(1));
+        assert_eq!(window.record(start + Duration::from_secs(660)), Some(0));
+    }
+
+    #[test]
+    fn concurrent_events_admit_one_sample_and_count_every_other_event() {
+        let window = Mutex::new(SampleWindow::new());
+        let start = Instant::now();
+        let samples = std::thread::scope(|scope| {
+            let workers: Vec<_> = (0..16)
+                .map(|_| {
+                    scope.spawn(|| {
+                        let mut samples = 0;
+                        for _ in 0..100 {
+                            if window.lock().record(start).is_some() {
+                                samples += 1;
+                            }
+                        }
+                        samples
+                    })
+                })
+                .collect();
+            workers
+                .into_iter()
+                .map(|worker| worker.join().unwrap())
+                .sum::<usize>()
+        });
+        assert_eq!(samples, 1);
+        assert_eq!(window.lock().record(start + SAMPLE_INTERVAL), Some(1599));
+    }
+}
