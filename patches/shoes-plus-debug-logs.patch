diff --git a/src/dns/no_addresses.rs b/src/dns/no_addresses.rs
new file mode 100644
index 0000000..aa2a69e
--- /dev/null
+++ b/src/dns/no_addresses.rs
@@ -0,0 +1,97 @@
+use std::error::Error;
+use std::fmt;
+use std::io;
+
+/// Marks a successful DNS lookup that yielded no usable addresses.
+#[derive(Debug)]
+struct NoAddressesError(String);
+
+impl fmt::Display for NoAddressesError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str(&self.0)
+    }
+}
+
+impl Error for NoAddressesError {}
+
+pub(crate) fn no_addresses_error(message: String) -> io::Error {
+    io::Error::other(NoAddressesError(message))
+}
+
+/// Recognizes the marker through both I/O wrappers and ordinary error sources.
+pub(crate) fn is_no_addresses_error(error: &io::Error) -> bool {
+    let mut current: Option<&(dyn Error + 'static)> = Some(error);
+    while let Some(error) = current {
+        if error.is::<NoAddressesError>() {
+            return true;
+        }
+
+        // io::Error::source can skip its contained error, so inspect get_ref
+        // before following the usual source chain.
+        current = error
+            .downcast_ref::<io::Error>()
+            .and_then(io::Error::get_ref)
+            .map(|inner| inner as &(dyn Error + 'static))
+            .or_else(|| error.source());
+    }
+    false
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn marker_preserves_error_kind_and_message() {
+        for message in [
+            "DNS lookup returned no addresses for example.test",
+            "native DNS lookup returned no addresses for example.test",
+        ] {
+            let error = no_addresses_error(message.to_owned());
+            assert_eq!(error.kind(), io::ErrorKind::Other);
+            assert_eq!(error.to_string(), message);
+            assert!(is_no_addresses_error(&error));
+        }
+    }
+
+    #[test]
+    fn recognizes_marker_inside_nested_io_errors() {
+        let error = io::Error::other(io::Error::other(no_addresses_error(
+            "DNS lookup returned no addresses for example.test".to_owned(),
+        )));
+        assert!(is_no_addresses_error(&error));
+    }
+
+    #[derive(Debug)]
+    struct WrappedError(io::Error);
+
+    impl fmt::Display for WrappedError {
+        fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+            formatter.write_str("wrapped resolver error")
+        }
+    }
+
+    impl Error for WrappedError {
+        fn source(&self) -> Option<&(dyn Error + 'static)> {
+            Some(&self.0)
+        }
+    }
+
+    #[test]
+    fn recognizes_marker_through_custom_error_source() {
+        let error = io::Error::other(WrappedError(io::Error::other(no_addresses_error(
+            "DNS lookup returned no addresses for example.test".to_owned(),
+        ))));
+        assert!(is_no_addresses_error(&error));
+    }
+
+    #[test]
+    fn does_not_recognize_unrelated_errors_with_identical_text() {
+        let message = "DNS lookup returned no addresses for example.test";
+        let error = io::Error::other(message);
+        assert!(!is_no_addresses_error(&error));
+        assert!(!is_no_addresses_error(&io::Error::other(WrappedError(
+            error
+        ))));
+    }
+}
