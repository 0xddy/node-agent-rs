+fn authenticated_close_log_level(reason: Option<&quinn::ConnectionError>) -> Option<log::Level> {
+    match reason {
+        None | Some(quinn::ConnectionError::LocallyClosed) => None,
+        Some(quinn::ConnectionError::ApplicationClosed(close))
+            if close.error_code == 0u32.into() || close.error_code == CLOSE_ERR_CODE_OK.into() =>
+        {
+            None
+        }
+        Some(quinn::ConnectionError::ConnectionClosed(close))
+            if close.error_code == quinn::TransportErrorCode::NO_ERROR =>
+        {
+            None
+        }
+        Some(quinn::ConnectionError::TimedOut) => Some(log::Level::Debug),
+        Some(_) => Some(log::Level::Warn),
+    }
