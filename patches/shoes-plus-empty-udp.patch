+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::async_stream::{
+        AsyncFlushMessage, AsyncPing, AsyncReadMessage, AsyncShutdownMessage, AsyncWriteMessage,
+    };
+    use std::sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+    };
+    use tokio::sync::mpsc;
+
+    struct ChannelStream {
+        incoming: mpsc::UnboundedReceiver<Vec<u8>>,
+        outgoing: mpsc::UnboundedSender<Vec<u8>>,
+        shutdown: Arc<AtomicBool>,
+        delay_write_once: bool,
+    }
+
+    impl AsyncReadMessage for ChannelStream {
+        fn poll_read_message(
+            mut self: Pin<&mut Self>,
+            cx: &mut Context<'_>,
+            buf: &mut ReadBuf<'_>,
+        ) -> Poll<io::Result<MessageReadStatus>> {
+            match self.incoming.poll_recv(cx) {
+                Poll::Ready(Some(message)) => {
+                    buf.put_slice(&message);
+                    Poll::Ready(Ok(MessageReadStatus::Message))
+                }
+                Poll::Ready(None) => Poll::Ready(Ok(MessageReadStatus::Eof)),
+                Poll::Pending => Poll::Pending,
+            }
+        }
+    }
+    impl AsyncWriteMessage for ChannelStream {
+        fn poll_write_message(
+            mut self: Pin<&mut Self>,
+            cx: &mut Context<'_>,
+            buf: &[u8],
+        ) -> Poll<io::Result<()>> {
+            if std::mem::take(&mut self.delay_write_once) {
+                cx.waker().wake_by_ref();
+                return Poll::Pending;
+            }
+            self.outgoing.send(buf.to_vec()).unwrap();
+            Poll::Ready(Ok(()))
+        }
+    }
+    impl AsyncFlushMessage for ChannelStream {
+        fn poll_flush_message(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> {
+            Poll::Ready(Ok(()))
+        }
+    }
+    impl AsyncShutdownMessage for ChannelStream {
+        fn poll_shutdown_message(
+            self: Pin<&mut Self>,
+            _: &mut Context<'_>,
+        ) -> Poll<io::Result<()>> {
+            self.shutdown.store(true, Ordering::SeqCst);
+            Poll::Ready(Ok(()))
+        }
+    }
+    impl AsyncPing for ChannelStream {
+        fn supports_ping(&self) -> bool {
+            false
+        }
+        fn poll_write_ping(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<bool>> {
+            Poll::Ready(Ok(false))
+        }
+    }
+    impl AsyncMessageStream for ChannelStream {}
+
+    fn channel_stream(
+        delay_write_once: bool,
+    ) -> (
+        ChannelStream,
+        mpsc::UnboundedSender<Vec<u8>>,
+        mpsc::UnboundedReceiver<Vec<u8>>,
+    ) {
+        let (input, incoming) = mpsc::unbounded_channel();
+        let (outgoing, output) = mpsc::unbounded_channel();
+        (
+            ChannelStream {
+                incoming,
+                outgoing,
+                shutdown: Arc::new(AtomicBool::new(false)),
+                delay_write_once,
+            },
+            input,
+            output,
+        )
+    }
+
+    #[tokio::test]
+    async fn empty_datagrams_survive_backpressure_in_both_directions_and_eof_closes() {
+        let (mut a, a_input, mut a_output) = channel_stream(true);
+        let (mut b, b_input, mut b_output) = channel_stream(true);
+        let b_shutdown = b.shutdown.clone();
+        let task =
+            tokio::spawn(
+                async move { copy_bidirectional_message(&mut a, &mut b, false, false).await },
+            );
+        tokio::time::timeout(std::time::Duration::from_secs(2), async {
+            for payload in [b"".as_slice(), b"after-empty", b""] {
+                a_input.send(payload.to_vec()).unwrap();
+                assert_eq!(b_output.recv().await.unwrap(), payload);
+                b_input.send(payload.to_vec()).unwrap();
+                assert_eq!(a_output.recv().await.unwrap(), payload);
+            }
+            assert!(!task.is_finished());
+            drop(a_input);
+            task.await.unwrap().unwrap();
+            assert!(b_shutdown.load(Ordering::SeqCst));
+        })
+        .await
+        .expect("empty message or EOF did not make progress");
+    }
+
+    #[tokio::test]
+    async fn empty_datagram_refreshes_an_expired_association() {
+        let (mut a, a_input, _a_output) = channel_stream(false);
+        let (mut b, _b_input, mut b_output) = channel_stream(false);
+        a_input.send(Vec::new()).unwrap();
+        let mut copy = Box::pin(CopyBidirectional {
+            a: &mut a,
+            b: &mut b,
+            a_buf: CopyBuffer::new(false),
+            b_buf: CopyBuffer::new(false),
+            a_to_b: TransferState::Running,
+            b_to_a: TransferState::Running,
+            sleep_future: Box::pin(tokio::time::sleep(std::time::Duration::from_secs(60))),
+            last_active: Instant::now()
+                - std::time::Duration::from_secs(u64::from(DEFAULT_ASSOCIATION_TIMEOUT_SECS) + 1),
+        });
+        std::future::poll_fn(|cx| {
+            assert!(copy.as_mut().poll(cx).is_pending());
+            Poll::Ready(())
+        })
+        .await;
+        assert_eq!(copy.a_buf.read_count, 1);
+        assert!(copy.last_active.elapsed().as_secs() < 1);
+        assert!(b_output.try_recv().unwrap().is_empty());
+    }
+}
